# Caching + security for static assets (XAMPP: mod_headers is enabled)
<IfModule mod_headers.c>
  # HTML must always revalidate so nav/auth state stays fresh
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Versioned assets (linked with ?v=) can cache aggressively
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Never serve tooling/dependency files or dotfiles
<FilesMatch "^(composer\.(phar|json|lock)|package(-lock)?\.json|\.+[^/]*|.*\.phar)$">
  Require all denied
</FilesMatch>
