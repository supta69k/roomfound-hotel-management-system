# Caching + security for static assets (XAMPP: mod_headers is enabled)
<IfModule mod_headers.c>
  # Enterprise Security Headers
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  Header always set X-XSS-Protection "1; mode=block"

  # HTML must always revalidate so nav/auth state stays fresh
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Versioned assets (linked with ?v=) can cache aggressively
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Never serve tooling/dependency files or dotfiles
<FilesMatch "^(composer\.(phar|json|lock)|package(-lock)?\.json|\.+[^/]*|.*\.phar)$">
  Require all denied
</FilesMatch>

# Never serve dependency code, the SQL dump or include-only PHP files over HTTP.
# PHP still loads them from disk; this only stops direct browser requests
# (for example PHPMailer's get_oauth_token.php example or composer metadata).
<IfModule mod_alias.c>
  RedirectMatch 404 (?i)/(vendor|database|node_modules)(/|$)
  RedirectMatch 404 (?i)/api/(config|db_config|mail_config|payment_config|send_mail|stripe|migrate)(\.example)?\.php$
  RedirectMatch 404 (?i)/api/[a-z_]+\.example\.php$
</IfModule>

# Custom 404 handler matching design system
ErrorDocument 404 /Hotel%20Management/src/404.html

